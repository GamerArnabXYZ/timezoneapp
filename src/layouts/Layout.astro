---
import "../styles/global.css";
import { withBase } from "../lib/tz-utils";

interface Props {
  title: string;
  description: string;
  canonicalSlug?: string; // e.g. "new-york-to-london"
  schema?: Record<string, unknown>;
}

const { title, description, canonicalSlug, schema } = Astro.props;
const canonicalURL = canonicalSlug
  ? new URL(withBase(`/${canonicalSlug}`), Astro.site)
  : new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=5" />
  <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
  <link rel="apple-touch-icon" href={withBase("/favicon.svg")} />
  <link rel="manifest" href={withBase("/manifest.json")} />
  <link rel="canonical" href={canonicalURL} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  {schema && (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  )}

  <!-- Geist substitutes per DESIGN-vercel.md — Inter (sans) + JetBrains Mono (mono) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500&display=swap"
    rel="stylesheet"
  />

  <script is:inline>
    // Zero-flash theme: saved manual choice wins, else follow system preference.
    const saved = localStorage.getItem("theme");
    const wantsDark = saved ? saved === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
    if (wantsDark) document.documentElement.classList.add("dark");
  </script>
</head>
<body class="min-h-screen bg-(--canvas) text-(--ink) antialiased">
  <!-- Fixed-height ad slots => zero CLS. Swap the comment for your AdSense <ins> block. -->
  <div class="mx-auto flex w-full max-w-3xl items-center justify-center" style="min-height:90px;">
    <!-- AdSense top slot -->
  </div>

  <header class="mx-auto flex max-w-3xl items-center justify-between px-4 py-3">
    <a href={withBase("/")} class="text-button-md font-semibold text-(--ink)">⏱ TZ Sync</a>
    <nav class="flex items-center gap-4">
      <a href={withBase("/world-clock")} class="text-body-sm text-(--body) hover:text-(--ink)">World Clock</a>
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle dark mode"
        class="tap-target flex h-9 w-9 items-center justify-center rounded-full border border-(--hairline) bg-(--canvas-elevated) text-base"
      >
        <span class="theme-icon">🌙</span>
      </button>
    </nav>
  </header>

  <slot />

  <div class="mx-auto flex w-full max-w-3xl items-center justify-center" style="min-height:90px;">
    <!-- AdSense bottom slot -->
  </div>

  <footer class="mx-auto max-w-3xl border-t border-(--hairline) px-4 py-8 text-center text-body-sm text-(--faint)">
    <p>Built with Astro · Times auto-detect from your device</p>
  </footer>

  <script>
    const btn = document.getElementById("theme-toggle");
    const icon = btn?.querySelector(".theme-icon");
    function syncIcon() {
      if (icon) icon.textContent = document.documentElement.classList.contains("dark") ? "☀️" : "🌙";
    }
    syncIcon();
    btn?.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
      syncIcon();
    });
  </script>

  <script define:vars={{ swUrl: withBase("/sw.js") }}>
    if ("serviceWorker" in navigator) {
      window.addEventListener("load", () => {
        navigator.serviceWorker.register(swUrl).catch(() => {
          /* offline support is a nice-to-have — fail silently */
        });
      });
    }
  </script>
</body>
</html>
