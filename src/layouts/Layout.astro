---
import "../styles/global.css";
import { withBase } from "../lib/tz-utils";

interface Props {
  title: string;
  description: string;
  canonicalSlug?: string; // e.g. "new-york-to-london"
  schema?: Record<string, unknown>;
}

const { title, description, canonicalSlug, schema } = Astro.props;
const canonicalURL = canonicalSlug
  ? new URL(withBase(`/${canonicalSlug}`), Astro.site)
  : new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=5" />
  <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
  <link rel="canonical" href={canonicalURL} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  {schema && (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  )}

  <script is:inline>
    // Zero-flash dark mode: apply before paint based on system preference (no input needed)
    if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
      document.documentElement.classList.add("dark");
    }
  </script>
</head>
<body class="min-h-screen bg-white text-neutral-900 antialiased dark:bg-neutral-950 dark:text-neutral-100">
  <!-- Fixed-height ad slots => zero CLS. Swap the comment for your AdSense <ins> block. -->
  <div class="ad-slot mx-auto flex w-full max-w-3xl items-center justify-center" style="min-height:90px;">
    <!-- AdSense top slot -->
  </div>

  <slot />

  <div class="ad-slot mx-auto flex w-full max-w-3xl items-center justify-center" style="min-height:90px;">
    <!-- AdSense bottom slot -->
  </div>

  <footer class="mx-auto max-w-3xl px-4 py-8 text-center text-xs text-neutral-400 dark:text-neutral-600">
    <p>Built with Astro · Times auto-detect from your device</p>
  </footer>
</body>
</html>
