---
// Renders inside ConverterWidget. Reads live values from the closest [data-widget] ancestor,
// set by ConverterWidget's own tick() script, and builds a shareable /t/4pm-utc style link.
---
<div class="share-link-wrap flex flex-col items-center gap-2 sm:flex-row sm:justify-between">
  <button
    type="button"
    class="share-btn tap-target inline-flex w-full items-center justify-center gap-2 rounded-[6px] border border-(--hairline) bg-(--canvas-elevated) px-4 py-3 text-button-md text-(--ink) transition active:scale-[0.98] sm:w-auto"
  >
    <span aria-hidden="true">🔗</span>
    <span class="btn-label">Copy shareable link</span>
  </button>
  <span class="share-hint text-body-sm text-(--faint)"
    >Sends your exact time in their local zone</span
  >
</div>

<script>
  import { buildShareSlug, withBase } from "../lib/tz-utils";

  document.querySelectorAll<HTMLButtonElement>(".share-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const widget = btn.closest<HTMLElement>("[data-widget]");
      if (!widget) return;
      const hour24 = parseInt(widget.dataset.currentHour24 ?? "12", 10);
      const fromKey = widget.dataset.fromTzKey ?? "utc";
      const slug = buildShareSlug(hour24, fromKey);
      const url = `${location.origin}${withBase(`/t/${slug}`)}`;

      try {
        await navigator.clipboard.writeText(url);
      } catch {
        // clipboard blocked (older webview) — fall back to a visible prompt
        window.prompt("Copy this link:", url);
      }

      const label = btn.querySelector(".btn-label");
      if (label) {
        const original = label.textContent;
        label.textContent = "Link copied!";
        setTimeout(() => (label.textContent = original), 1800);
      }
    });
  });
</script>
