---
interface Props {
  position: "top" | "bottom" | "in-content";
}
const { position } = Astro.props;
---
<!--
  Fixed min-height => CLS-safe (Core Web Vitals). Replace inner comment with your
  AdSense <ins class="adsbygoogle"> block once approved. Keep min-height as-is.
-->
<div
  class="mx-auto my-4 flex w-full max-w-3xl items-center justify-center rounded-[12px] border border-(--hairline) bg-(--hairline-soft) text-body-sm text-(--faint)"
  style="min-height:90px;"
  data-ad-position={position}
>
  Ad slot ({position})
</div>
