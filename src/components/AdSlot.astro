---
interface Props {
  position: "top" | "bottom" | "in-content";
}
const { position } = Astro.props;
---
<!--
  Fixed min-height => CLS-safe (Core Web Vitals). Replace inner comment with your
  AdSense <ins class="adsbygoogle"> block once approved. Keep min-height as-is.
-->
<div
  class="ad-slot mx-auto my-4 flex w-full max-w-3xl items-center justify-center rounded-xl border border-neutral-200 bg-neutral-50 text-[11px] text-neutral-400 dark:border-neutral-800 dark:bg-neutral-900/40"
  style="min-height:90px;"
  data-ad-position={position}
>
  Ad slot ({position})
</div>
