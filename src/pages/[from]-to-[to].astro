---
import Layout from "../layouts/Layout.astro";
import ConverterWidget from "../components/ConverterWidget.astro";
import AdSlot from "../components/AdSlot.astro";
import { FEATURED_TIMEZONES } from "../data/timezones";
import { getAbbr, bestMeetingWindow } from "../lib/tz-utils";

export function getStaticPaths() {
  const paths = [];
  for (const from of FEATURED_TIMEZONES) {
    for (const to of FEATURED_TIMEZONES) {
      if (from.slug === to.slug) continue;
      paths.push({
        params: { from: from.slug, to: to.slug },
        props: { fromTz: from, toTz: to },
      });
    }
  }
  return paths;
}

const { fromTz, toTz } = Astro.props;
const fromAbbr = getAbbr(fromTz.tz);
const toAbbr = getAbbr(toTz.tz);
const meeting = bestMeetingWindow(fromTz.tz, toTz.tz);

const title = `${fromTz.city} to ${toTz.city} Time Zone Converter — ${fromAbbr} to ${toAbbr}`;
const description = `Convert ${fromTz.city} (${fromAbbr}) time to ${toTz.city} (${toAbbr}) instantly. Live clocks, day/night visual, best-meeting-time finder, and a one-click shareable link.`;
const canonicalSlug = `${fromTz.slug}-to-${toTz.slug}`;

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: title,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Any",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description,
};
---
<Layout title={title} description={description} canonicalSlug={canonicalSlug} schema={schema}>
  <main>
    <div class="mx-auto max-w-3xl px-4 pt-10 text-center sm:pt-14">
      <p class="text-mono-eyebrow text-(--mute)">Time zone converter</p>
      <h1 class="text-heading-lg mt-2 text-(--ink)">
        {fromTz.city} to {toTz.city}
      </h1>
      <p class="text-body-md mt-2 text-(--body)">
        {fromAbbr} → {toAbbr} · Auto-updates every second · No sign-up needed
      </p>
    </div>

    <ConverterWidget fromTz={fromTz} toTz={toTz} />

    <AdSlot position="in-content" />

    <section class="mx-auto max-w-3xl px-4 pb-12 text-body-md text-(--body)">
      <h2 class="text-heading-md mb-2 text-(--ink)">
        Planning a call between {fromTz.city} and {toTz.city}?
      </h2>
      <p>
        {fromTz.city} runs on {fromAbbr}, while {toTz.city} uses {toAbbr}.
        {meeting
          ? ` The best overlap for a meeting is typically ${meeting.label} ${fromTz.city} time — both sides land in normal working hours.`
          : ` These zones barely overlap during normal working hours — one side will need to take an early or late call.`}
        {" "}Use the slider above to see daylight hours at a glance, then tap "Copy shareable link" to
        send an exact meeting time that auto-converts to whoever opens it — wherever they are.
      </p>
    </section>
  </main>
</Layout>
