---
import Layout from "../layouts/Layout.astro";
import ConverterWidget from "../components/ConverterWidget.astro";
import AdSlot from "../components/AdSlot.astro";
import { TIMEZONES } from "../data/timezones";

export function getStaticPaths() {
  const paths = [];
  for (const from of TIMEZONES) {
    for (const to of TIMEZONES) {
      if (from.slug === to.slug) continue;
      paths.push({
        params: { from: from.slug, to: to.slug },
        props: { fromTz: from, toTz: to },
      });
    }
  }
  return paths;
}

const { fromTz, toTz } = Astro.props;

const title = `${fromTz.city} to ${toTz.city} Time Zone Converter — ${fromTz.abbr} to ${toTz.abbr}`;
const description = `Convert ${fromTz.city} (${fromTz.abbr}) time to ${toTz.city} (${toTz.abbr}) instantly. Live clocks, day/night visual, and a one-click shareable meeting link.`;
const canonicalSlug = `${fromTz.slug}-to-${toTz.slug}`;

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: title,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Any",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description,
};
---
<Layout title={title} description={description} canonicalSlug={canonicalSlug} schema={schema}>
  <main>
    <div class="mx-auto max-w-3xl px-4 pt-10 text-center sm:pt-14">
      <p class="text-mono-eyebrow text-(--mute)">Time zone converter</p>
      <h1 class="text-heading-lg mt-2 text-(--ink)">
        {fromTz.city} to {toTz.city}
      </h1>
      <p class="text-body-md mt-2 text-(--body)">
        {fromTz.abbr} → {toTz.abbr} · Auto-updates every second · No sign-up needed
      </p>
    </div>

    <ConverterWidget fromTz={fromTz} toTz={toTz} />

    <AdSlot position="in-content" />

    <section class="mx-auto max-w-3xl px-4 pb-12 text-body-md text-(--body)">
      <h2 class="text-heading-md mb-2 text-(--ink)">
        Planning a call between {fromTz.city} and {toTz.city}?
      </h2>
      <p>
        {fromTz.city} runs on {fromTz.abbr}, while {toTz.city} uses {toTz.abbr}. Use the slider above
        to see daylight hours at a glance, then tap "Copy shareable link" to send an exact meeting
        time that auto-converts to whoever opens it — wherever they are.
      </p>
    </section>
  </main>
</Layout>
